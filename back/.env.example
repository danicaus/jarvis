# Porta do servidor Express
PORT=3001

# Origem permitida no CORS (URL do front em dev)
FRONTEND_ORIGIN=http://localhost:5173

# Segredo pra assinar o JWT da sessão — gerar algo aleatório de verdade, ex.:
# openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-aleatorio

# Client ID do OAuth "Sign in with Google" (console.cloud.google.com > APIs & Services
# > Credentials > OAuth client ID > tipo "Web application")
GOOGLE_CLIENT_ID=

# Emails autorizados a logar (separados por vírgula) — sem isso, qualquer conta
# Google que passar pela verificação do ID token conseguiria se autocadastrar
ALLOWED_EMAILS=seu-email@gmail.com

# Connection string do Postgres (Neon) — pegue em console.neon.tech > seu projeto >
# Connection Details. Inclua o ?sslmode=require que o Neon já sugere.
DATABASE_URL=